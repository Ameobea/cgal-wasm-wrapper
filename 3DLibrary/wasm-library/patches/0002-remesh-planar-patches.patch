+      if (b<a) continue; // each undirected edge is paired once, from its smaller corner
+      auto lo = std::lower_bound(bucket.begin()+offsets[b], bucket.begin()+offsets[b+1], a,
+                                 [&](std::size_t j, std::size_t v) { return target(j) < v; });
