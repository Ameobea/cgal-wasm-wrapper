+static inline int64_t as_i64(double x) {
+  int64_t i;
+  std::memcpy(&i, &x, sizeof i);
+  return i;
+}
+static inline double as_f64(int64_t i) {
+  double x;
+  std::memcpy(&x, &i, sizeof x);
+  return x;
