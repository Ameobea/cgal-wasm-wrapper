patch-deps:
  #!/bin/bash
  set -e
  python3 apply-patches.py

build:
  #!/bin/bash

  just patch-deps

  bash build.sh gener
  if ! tail -n 5 ./build/index.js | grep -q "export { CGAL }"; then
    echo "export { CGAL }" >> ./build/index.js
  fi
  wasm-opt build/index.wasm -g --strip-dwarf -O4 --enable-exception-handling --enable-bulk-memory --enable-simd --enable-relaxed-simd --enable-nontrapping-float-to-int --precompute-propagate -o build/index.wasm

install:
  cp build/index.* ~/dream/src/viz/wasm/cgal/
  # Vite ignores src/viz/wasm; clear its cached JS after replacing the JS/Wasm pair.
  if [ -f ~/dream/vite.config.js ]; then touch ~/dream/vite.config.js; fi

check-patches:
  python3 apply-patches.py --check

test-patches:
  python3 patches/test_apply.py
